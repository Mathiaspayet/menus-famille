# Copier ce fichier en « .env » sur le NAS (/volume1/docker/menus-famille/.env)
# et remplacer les valeurs. Ne jamais mettre le .env sur GitHub.

# Clé secrète Django : une longue chaîne aléatoire, à générer une fois.
# Par ex. : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer

DJANGO_DEBUG=False

# Adresses par lesquelles on ouvre l'appli (IP locale du NAS, nom de domaine…)
DJANGO_ALLOWED_HOSTS=192.168.1.XX,menus.mondomaine.fr

# Adresse HTTPS complète si l'appli passe par le reverse proxy du NAS
DJANGO_CSRF_TRUSTED_ORIGINS=https://menus.mondomaine.fr
# Mettre True une fois l'accès HTTPS en place
DJANGO_HTTPS=False

# Compte administrateur créé au premier démarrage
DJANGO_SUPERUSER_USERNAME=mathias
DJANGO_SUPERUSER_PASSWORD=a-remplacer
DJANGO_SUPERUSER_EMAIL=

# Facultatif : adresse d'un projet Claude « Menus famille ».
# Vide = le bouton ouvre une nouvelle conversation avec la question pré-remplie.
CLAUDE_PROJECT_URL=
